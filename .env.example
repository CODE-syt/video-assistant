# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Docker Compose (use URL-safe characters in the password)
MONGO_USER=video
MONGO_PASSWORD=
DOMAIN=localhost
# Local dev without Docker
MONGO_URI=mongodb://localhost:27017
# Set to "development" only for local http testing (disables secure cookies, allows default secret)
FLASK_ENV=production
# Optional
ANTHROPIC_MODEL=claude-sonnet-4-5
MAX_UPLOAD_MB=100
NUM_FRAMES=8
SESSION_TTL_DAYS=30
